<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lyw.friend.mapper.user.UserSubmitMapper">
    <select id="selectUserSubmit" resultType="com.lyw.friend.domain.user.UserSubmit">
        SELECT
        submit_id,
        pass,
        exe_message,
        case_judge_res,
        score
        FROM
        tb_user_submit
        WHERE submit_id = #{submitId} AND user_id = #{userId}

    </select>
</mapper>
